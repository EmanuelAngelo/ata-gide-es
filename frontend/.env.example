# Escolha o destino da API:
#   local      → http://127.0.0.1:8002 (backend Docker/local)
#   production → https://emanuelcoutinho.pythonanywhere.com
VITE_API_MODE=production

# Opcional: sobrescreve o preset acima.
# Deixe vazio (VITE_API_BASE_URL=) para usar o proxy do Vite em dev (/api → backend).
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL=https://emanuelcoutinho.pythonanywhere.com

# Usado pelo proxy do Vite (Docker)
VITE_PROXY_TARGET=http://backend:8000
